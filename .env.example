# Database
DATABASE_URL=postgresql://user:password@localhost:5432/respawn

# JWT
JWT_SECRET=replace-with-32-plus-char-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# IGDB (uses Twitch OAuth)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Uploadthing (file uploads)
UPLOADTHING_TOKEN=

# Upstash Redis (rate limiting — optional, falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# S3 (optional, legacy presign stub — not used in production)
S3_ENDPOINT=
